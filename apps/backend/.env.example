DATABASE_URL="file:./dev.db"
# Para QA aislada puede usarse: file:./transport-qa-copy.db
SESSION_COOKIE_NAME="mbs_session"
SESSION_TTL_HOURS="12"
DEPLOYMENT_VERSION="development"
APP_PUBLIC_URL="http://localhost:3000"

# Facturación. mock sólo para desarrollo/E2E; stripe para producción.
BILLING_PROVIDER="mock"
ALLOW_MOCK_BILLING="false"
BILLING_MOCK_WEBHOOK_SECRET="cambia-esta-firma-local"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Correo transaccional con outbox y reintentos. log sólo en desarrollo.
EMAIL_PROVIDER="log"
ALLOW_LOG_EMAIL="false"
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
BILLING_EVENT_RETENTION_DAYS="730"
EMAIL_OUTBOX_RETENTION_DAYS="365"

# Worker, recuperación y retención operativa.
JOB_RUNNER_SECRET="cambia-por-una-clave-aleatoria-de-32-caracteres"
JOB_MAX_ATTEMPTS="3"
JOB_RETRY_BASE_SECONDS="5"
JOB_STALE_MINUTES="15"
EXPORT_RETENTION_HOURS="24"
HOUSEKEEPING_INTERVAL_MINUTES="15"
JOB_METADATA_RETENTION_DAYS="90"
AUDIT_RETENTION_DAYS="730"
LOGIN_THROTTLE_RETENTION_DAYS="30"
STORAGE_METADATA_RETENTION_DAYS="730"

# Archivos. En producción OBJECT_STORAGE_PROVIDER es obligatorio: gcs o s3.
OBJECT_STORAGE_PROVIDER="local"
OBJECT_STORAGE_LOCAL_DIR=".object-storage"
SIGNED_URL_TTL_SECONDS="300"
DOCUMENT_MAX_MB="10"

# Google Cloud Storage (OBJECT_STORAGE_PROVIDER=gcs).
GOOGLE_CLOUD_PROJECT=""
GCS_BUCKET=""

# Railway Bucket, AWS S3, R2, MinIO u otro compatible (OBJECT_STORAGE_PROVIDER=s3).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Antivirus: disabled para desarrollo; clamav + REQUIRE_ANTIVIRUS=true en producción.
ANTIVIRUS_MODE="disabled"
REQUIRE_ANTIVIRUS="false"
CLAMAV_HOST=""
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="15000"

# Sólo para el bootstrap inicial de un entorno PostgreSQL vacío.
BOOTSTRAP_TENANT_SLUG="mi-empresa"
BOOTSTRAP_TENANT_NAME="Mi Empresa"
BOOTSTRAP_TENANT_TYPE="BARBERSHOP"
BOOTSTRAP_BRANCH_NAME="Sede principal"
BOOTSTRAP_ADMIN_NAME="Administrador de plataforma"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="cambia-esta-clave-segura"

# Lectura de cartas PDF (opcional, solo servidor)
MISTRAL_API_KEY=
MENU_IMPORT_MONTHLY_PAGES=50
