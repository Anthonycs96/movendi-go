  unit          String   @default("UND")
  stock         Float    @default(0)
  minimumStock  Float    @default(0)
  unitCostCents Int      @default(0)
  trackStock    Boolean  @default(true)
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]
  purchaseLines     InventoryPurchaseLine[]
  countLines        InventoryCountLine[]
  recipeIngredients ProductRecipeIngredient[]

  @@unique([tenantId, branchId, sku])
  @@index([tenantId, branchId, active])
  @@index([tenantId, branchId, stock, minimumStock])
  @@map("TransportInventoryItem")
}

model InventoryMovement {
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String?
  itemId         String
  actorId        String?
  type           String
  direction      String   @default("IN")
  quantity       Float
  stockBefore    Float    @default(0)
  stockAfter     Float    @default(0)
  unitCostCents  Int      @default(0)
  totalCostCents Int      @default(0)
  originType     String   @default("MANUAL")
  originId       String?
  idempotencyKey String?
  orderId        String?
  saleId         String?
  purchaseId     String?
  countId        String?
  reference      String?
  notes          String?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item     InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor    User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  order    RestaurantOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sale     Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase InventoryPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  count    InventoryCount?    @relation(fields: [countId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, itemId, occurredAt])
  @@index([tenantId, branchId, type, occurredAt])
  @@index([saleId])
  @@index([orderId])
  @@map("TransportInventoryMovement")
}

model InventoryPurchase {
  supplierId String?
  supplier InventorySupplier? @relation(fields: [supplierId], references: [id])
  payable InventoryPayable?
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String
  createdById    String
  code           String
  supplierName   String
  documentNumber String?
  status         String   @default("POSTED")
  totalCents     Int      @default(0)
  notes          String?
  purchasedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User                    @relation(fields: [createdById], references: [id])
  lines     InventoryPurchaseLine[]
  movements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, purchasedAt])
  @@index([tenantId, branchId, supplierName])
}

model InventoryPurchaseLine {
  id            String @id @default(cuid())
  purchaseId    String
  itemId        String
  quantity      Float
  unitCostCents Int
  totalCents    Int

  purchase InventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id])

  @@index([purchaseId])
  @@index([itemId])
}

model InventoryCount {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String
  createdById String
  code        String
  status      String   @default("POSTED")
  notes       String?
  countedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User                 @relation(fields: [createdById], references: [id])
  lines     InventoryCountLine[]
  movements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, countedAt])
}

model InventoryCountLine {
  id               String @id @default(cuid())
  countId          String
  itemId           String
  expectedQuantity Float
  countedQuantity  Float
  difference       Float

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  InventoryItem  @relation(fields: [itemId], references: [id])

  @@unique([countId, itemId])
  @@index([itemId])
}

model ProductRecipe {
  id            String   @id @default(cuid())
  productId     String   @unique
  yieldQuantity Float    @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients ProductRecipeIngredient[]
}

model ProductRecipeIngredient {
  id           String @id @default(cuid())
  recipeId     String
  itemId       String
  quantity     Float
  wastePercent Float  @default(0)

  recipe ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([recipeId, itemId])
  @@index([itemId])
}

model TransportTire {
  id               String               @id @default(cuid())
  tenantId         String
  serialNo         String
  brand            String
  model            String?
  size             String
  purchaseAt       DateTime?
  purchaseCents    Int                  @default(0)
  initialTreadMm   Float?
  currentTreadMm   Float?
  status           String               @default("STOCK")
  currentVehicleId String?
  currentPosition  String?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events           TransportTireEvent[]

  @@unique([tenantId, serialNo])
  @@index([tenantId, status, active])
  @@index([tenantId, active, serialNo])
}

model TransportDataJob {
  id              String        @id @default(cuid())
  tenantId        String
  actorId         String
  type            String
  format          String
  status          String        @default("QUEUED")
  parameters      String
  resultName      String?
  resultMime      String?
  resultData      String?
  storageObjectId String?
  error           String?
  attempts        Int           @default(0)
  maxAttempts     Int           @default(3)
  runAfter        DateTime      @default(now())
  startedAt       DateTime?
  heartbeatAt     DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor           User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  storageObject   StoredObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([status, runAfter])
  @@index([status, startedAt])
  @@index([expiresAt])
  @@index([tenantId, createdAt])
  @@index([storageObjectId])
}

model StoredObject {
  id           String              @id @default(cuid())
  tenantId     String
  createdById  String
  provider     String
  bucket       String
  key          String
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  purpose      String
  status       String              @default("ACTIVE")
  scanStatus   String              @default("SKIPPED")
  expiresAt    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  documents    TransportDocument[]
  dataJobs     TransportDataJob[]

  @@unique([provider, bucket, key])
  @@index([tenantId, purpose, status, createdAt])
  @@index([status, expiresAt])
}

model TransportTireEvent {
  id         String            @id @default(cuid())
  tenantId   String
  tireId     String
  vehicleId  String?
  type       String
  position   String?
  treadMm    Float?
  odometerKm Float?
  costCents  Int               @default(0)
  notes      String?
  occurredAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tire       TransportTire     @relation(fields: [tireId], references: [id], onDelete: Cascade)
  vehicle    TransportVehicle? @relation(fields: [vehicleId], references: [id])

  @@index([tenantId, tireId, occurredAt])
}

model RestaurantMenuImport {
  id String @id @default(cuid())
  tenantId String
  branchId String
  actorId String
  filename String
  sourceManifest String @default("[]")
  sourceVerified Boolean @default(false)
  sourceHash String
  pageCount Int
  nextPage Int @default(0)
  attempts Int @default(0)
  status String @default("DRAFT")
  rows String @default("[]")
  lastError String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
  @@index([tenantId, branchId, createdAt])
}

model PlatformIntegration {
  provider String @id
  encryptedToken String
  iv String
  authTag String
  tokenHint String
  updatedById String
  lastTestedAt DateTime?
  updatedAt DateTime @updatedAt
}

model ExternalBackupRun {
  id String @id
  status String
  startedAt DateTime
  completedAt DateTime?
  prefix String
  files Int @default(0)
  bytes Float @default(0)
  restoreVerified Boolean @default(false)
  error String?
  @@index([startedAt])
}

model RestaurantLaunchPlan {
  id String @id @default(cuid())
  tenantId String
  branchId String
  owner String @default("")
  supportContact String @default("")
  supportHours String @default("")
  escalation String @default("")
  participants String @default("")
  devices String @default("")
  status String @default("DRAFT")
  checks String @default("{}")
  startedAt DateTime?
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([tenantId, branchId])
}

model RestaurantSupportTicket {
  id String @id @default(cuid())
  tenantId String
  branchId String
  createdById String
  subject String
  details String
  priority String @default("NORMAL")
  status String @default("OPEN")
  assignedTo String @default("")
  resolution String @default("")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, branchId, createdAt])
  @@index([status, priority, createdAt])
}

// Retail quantities use the same six-decimal normalization as Inventory.
model RetailProduct {
  promotions Promotion[]
  expiryAlertDays Int @default(30)
  taxCategory String @default("UNCLASSIFIED")
  id String @id @default(cuid())
  tenantId String
  branchId String
  itemId String @unique
  category String @default("General")
  trackExpiry Boolean @default(false)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  item InventoryItem @relation(fields: [itemId], references: [id])
  presentations RetailPresentation[]
  lots RetailLot[]
  @@index([tenantId, branchId])
}

model InventorySupplier {
  id String @id @default(cuid())
  tenantId String
  branchId String
  documentType String
  documentNumber String
  name String
  phone String?
  email String?
  address String?
  contact String?
  active Boolean @default(true)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  purchases InventoryPurchase[]
  payables InventoryPayable[]
  @@unique([tenantId, branchId, documentType, documentNumber])
}

model InventoryPayable {
  id String @id @default(cuid())
  tenantId String
  branchId String
  supplierId String
  purchaseId String @unique
  currency String
  totalCents Int
  paidCents Int @default(0)
  dueOn String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  supplier InventorySupplier @relation(fields: [supplierId], references: [id])
  purchase InventoryPurchase @relation(fields: [purchaseId], references: [id])
  payments InventorySupplierPayment[]
  @@index([tenantId, branchId, dueOn])
}

model InventorySupplierPayment {
  id String @id @default(cuid())
  payableId String
  actorId String
  amountCents Int
  method String
  reference String?
  createdAt DateTime @default(now())
  payable InventoryPayable @relation(fields: [payableId], references: [id])
  @@index([payableId, createdAt])
}
// Frozen presentation, quantity, cost and lot allocations provide transit traceability.
model RetailTransfer {
  id String @id @default(cuid())
  tenantId String
  sourceBranchId String
  destinationBranchId String
  createdById String
  dispatchedById String?
  receivedById String?
  status String @default("DRAFT")
  lines String
  notes String?
  createdAt DateTime @default(now())
  dispatchedAt DateTime?
  receivedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source Branch @relation("RetailTransferSource", fields: [sourceBranchId], references: [id])
  destination Branch @relation("RetailTransferDestination", fields: [destinationBranchId], references: [id])
  @@index([tenantId, sourceBranchId, status])
  @@index([tenantId, destinationBranchId, status])
}
model RetailPresentation {
  promotions Promotion[]
  sku String?
  @@unique([tenantId, branchId, sku])
  id String @id @default(cuid())
  tenantId String
  branchId String
  productId String
  name String
  barcode String?
  factor Float @default(1)
  priceCents Int
  weighted Boolean @default(false)
  active Boolean @default(true)
  product RetailProduct @relation(fields: [productId], references: [id])
  @@unique([tenantId, branchId, barcode])
  @@unique([productId, name])
}
model RetailLot {
  id String @id @default(cuid())
  productId String
  code String
  expiresOn String
  stock Float @default(0)
  product RetailProduct @relation(fields: [productId], references: [id])
  @@unique([productId, code])
  @@index([productId, expiresOn])
}
model RetailSale {
  id String @id @default(cuid())
  tenantId String
  branchId String
  version Int @default(0)
  refundedPayments String @default("[]")
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  sale Sale?
  lines RetailSaleLine[]
  @@index([tenantId, branchId, createdAt])
}
model RetailSaleLine {
  discountCents Int @default(0)
  promotionName String?
  id String @id @default(cuid())
  retailSaleId String
  itemId String
  presentationId String
  name String
  quantity Float
  factor Float
  unitPriceCents Int
  totalCents Int
  unitCostCents Int
  allocations String @default("[]")
  returnedQuantity Float @default(0)
  refundedCents Int @default(0)
  retailSale RetailSale @relation(fields: [retailSaleId], references: [id])
  @@index([retailSaleId])
}
// Durable request result for checkout, purchases, counts and partial refunds.
model RetailOperation {
  id String @id
  tenantId String
  branchId String
  kind String
  payloadHash String
  result String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  @@index([tenantId, branchId, kind, createdAt])
}

model FiscalConfiguration {
  id String @id @default(cuid())
  tenantId String
  branchId String @unique
  enabled Boolean @default(false)
  environment String @default("BETA")
  taxRatePct Float @default(18)
  invoiceSeries String @default("F001")
  receiptSeries String @default("B001")
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}
// Transactional outbox for fiscal delivery. Payload and provider route are immutable.
model FiscalJob {
  id String @id @default(cuid())
  tenantId String
  branchId String
  actorId String
  saleId String
  originKey String @unique
  kind String
  series String
  number Int
  environment String
  apiUrl String
  payload String
  status String @default("PENDING")
  attempts Int @default(0)
  leaseToken String?
  leaseExpiresAt DateTime?
  nextAttemptAt DateTime @default(now())
  lastError String?
  response String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@unique([tenantId, kind, series, number])
  @@index([status, nextAttemptAt])
  @@index([tenantId, branchId, saleId])
}
