{
  "name": "multi-business-saas-v2",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-workspaces.mjs --network",
    "dev:local": "node scripts/dev-workspaces.mjs",
    "dev:network": "node scripts/dev-workspaces.mjs --network",
    "dev:frontend": "npm run dev -w @movendi/frontend",
    "dev:backend": "npm run dev -w @movendi/backend",
    "build": "npm run build -w @movendi/backend && npm run build -w @movendi/frontend",
    "build:backend": "npm run build -w @movendi/backend",
    "build:frontend": "npm run build -w @movendi/frontend",
    "start:backend": "npm run start -w @movendi/backend",
    "start:frontend": "npm run start -w @movendi/frontend",
    "typecheck": "npm run typecheck -w @movendi/contracts && npm run typecheck -w @movendi/backend && npm run typecheck -w @movendi/frontend",
    "lint": "eslint apps packages e2e scripts",
    "test": "npm run test -w @movendi/frontend && npm run test -w @movendi/backend",
    "db:generate": "npm run db:generate -w @movendi/backend",
    "db:migrate": "npm run db:migrate -w @movendi/backend",
    "db:deploy": "npm run db:deploy -w @movendi/backend",
    "db:push": "npm run db:push -w @movendi/backend",
    "db:seed": "npm run db:seed -w @movendi/backend",
    "db:schema:prod": "npm run db:schema:prod -w @movendi/backend",
    "db:generate:prod": "npm run db:generate:prod -w @movendi/backend",
    "db:deploy:prod": "npm run db:deploy:prod -w @movendi/backend",
    "db:bootstrap:prod": "npm run db:bootstrap:prod -w @movendi/backend",
    "db:bootstrap:runtime": "npm run db:bootstrap:runtime -w @movendi/backend",
    "db:check:migrations": "node scripts/check-prisma-migrations.mjs",
    "db:restore:local": "node scripts/restore-sqlite.mjs",
    "test:recovery": "node --test scripts/sqlite-recovery.test.mjs",
    "db:backup:local": "node scripts/backup-sqlite.mjs",
    "db:studio": "npm run db:studio -w @movendi/backend",
    "jobs:worker": "npm run jobs:worker -w @movendi/backend",
    "jobs:once": "npm run jobs:once -w @movendi/backend",
    "jobs:runner": "node scripts/transport-job-runner.mjs",
    "jobs:runner:once": "node scripts/transport-job-runner.mjs --once",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:restaurant:ui": "node scripts/run-e2e.mjs e2e/restaurant-frontend-journey.spec.ts",
    "e2e:restaurant:audit": "node scripts/run-e2e.mjs e2e/platform-superadmin.spec.ts e2e/restaurant-configuration.spec.ts e2e/restaurant-production-audit.spec.ts",
    "e2e:transport:30": "node scripts/run-e2e.mjs e2e/transport-real-30.spec.ts",
    "e2e:transport:operations": "node scripts/run-e2e.mjs e2e/transport-operations-maintenance.spec.ts",
    "e2e:transport:phase2": "node scripts/run-e2e.mjs e2e/transport-phase-2.spec.ts",
    "e2e:phase3": "node scripts/run-e2e.mjs e2e/phase-3-reliability.spec.ts",
    "e2e:phase4": "node scripts/run-e2e.mjs e2e/phase-4-object-storage.spec.ts",
    "e2e:phase5": "node scripts/run-e2e.mjs e2e/phase-5-commercial.spec.ts",
    "e2e:40": "node scripts/run-e2e.mjs e2e/scenarios-40.spec.ts",
    "e2e:attentions:40": "node scripts/run-e2e.mjs e2e/real-attentions-40.spec.ts",
    "transport:load": "node scripts/transport-load-test.mjs",
    "release:check": "npm run db:check:migrations && npm run typecheck && npm run lint && npm run build",
    "security:staged": "node scripts/check-staged-secrets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.4",
    "next": "16.3.4",
    "railway": "^3.11.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
